# write inference/reranker_prod.py
cat > inference/reranker_prod.py <<'PY'
from typing import List, Dict, Tuple
import sympy as sp
from src.services.dimension_validator import DimensionValidator

dv = DimensionValidator()

def try_parse(expr_str: str) -> Tuple[bool, str]:
    try:
        expr = sp.sympify(expr_str)
        return True, str(expr)
    except Exception as e:
        return False, str(e)

def score_candidate(pred_text: str, model_logprob: float = None) -> Tuple[float, Dict]:
    parse_ok, parse_info = try_parse(pred_text)
    parse_score = 1.0 if parse_ok else 0.0
    dim_res = dv.validate_formula(pred_text) if parse_ok else {'is_valid': False}
    dim_ok = 1.0 if dim_res.get('is_valid') else 0.0
    lm_score = 0.0
    if model_logprob is not None:
        try:
            lm_score = -float(model_logprob)
        except Exception:
            lm_score = 0.0
    score = (5.0 * parse_score) + (3.0 * dim_ok) + (0.1 * lm_score)
    meta = {'parse_ok': bool(parse_ok), 'parse_info': parse_info, 'dim_ok': bool(dim_res.get('is_valid')), 'dim_details': dim_res}
    return score, meta

def rerank(candidates: List[Dict]) -> Tuple[Dict, List[Tuple[float, str, Dict]]]:
    scored = []
    for c in candidates:
        text = c.get('text') or c.get('pred') or ''
        lp = c.get('logprob')
        s, meta = score_candidate(text, lp)
        scored.append((s, text, meta))
    scored.sort(reverse=True, key=lambda x: x[0])
    best = {'text': scored[0][1], 'score': scored[0][0], 'meta': scored[0][2]} if scored else None
    return best, scored

if __name__ == '__main__':
    cands = [
        {'text': 'E = 1/2 * m * v ** 2', 'logprob': -10},
        {'text': 'E = m * c ** 2', 'logprob': -12},
        {'text': 'E = m + c', 'logprob': -5},
    ]
    best, scored = rerank(cands)
    print('Best:', best)
    print('All:', scored)
PY

