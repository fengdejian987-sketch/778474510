from transformers import TrainerCallback

class CompositeMetricCallback(TrainerCallback):
    """Trainer callback to synthesize a composite metric from available eval metrics.
    Composite metric example:
      composite = 0.4 * bleu + 0.3 * (parse_rate * 100) + 0.3 * (dim_rate * 100)
    """
    def on_evaluate(self, args, state, control, metrics=None, **kwargs):
        if metrics is None:
            return
        bleu = metrics.get('bleu', 0.0)
        parse_rate = metrics.get('parse_rate')
        dim_rate = metrics.get('dim_rate')
        def norm(x):
            if x is None:
                return 0.0
            try:
                xv = float(x)
                if xv > 1.5:
                    return xv / 100.0
                return xv
            except Exception:
                return 0.0
        parse_rate = norm(parse_rate)
        dim_rate = norm(dim_rate)
        composite = 0.4 * bleu + 0.3 * (parse_rate * 100.0) + 0.3 * (dim_rate * 100.0)
        metrics['composite_metric'] = composite
