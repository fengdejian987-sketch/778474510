name: Train smoke (small)

on:
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  smoke-train:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-training.txt || true

      - name: Run smoke training script
        run: |
          bash scripts/run_smoke_train.sh

      - name: Upload eval results
        uses: actions/upload-artifact@v4
        with:
          name: smoke-eval-results
          path: outputs/mt5-smoke/eval_results.jsonl
YML

