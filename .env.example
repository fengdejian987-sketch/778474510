# Environment example for development and testing
# DO NOT commit real credentials or production secrets. Use GitHub Actions secrets or cloud secret managers for production.

# Environment
ENVIRONMENT=development
DEBUG=False

# Database
DB_USER=postgres
DB_PASSWORD=your_password_here  # DO NOT commit real credentials. Use CI/secret manager in production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=formula_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Machine Learning
ML_MODEL_NAME=google/mt5-base
ML_DEVICE=cuda
ML_MAX_LENGTH=512
ML_BATCH_SIZE=32
ML_LEARNING_RATE=5e-5
ML_EPOCHS=3
ML_MODEL_CACHE=./models

# Logging & cache
LOG_LEVEL=INFO
CACHE_TTL=3600
